{
  "mcpServers": {
    "dodopayments": {
      "command": "npx",
      "args": [
        "-y",
        "dodopayments-mcp"
      ],
      "env": {
        "DODO_PAYMENTS_API_KEY": "SET_IN_LOCAL_ENV_ONLY"
      }
    },
    "brevo": {
      "command": "npx",
      "args": [
        "-y",
        "brevo-mcp"
      ],
      "env": {
        "BREVO_API_KEY": "SET_IN_LOCAL_ENV_ONLY"
      }
    }
  }
}